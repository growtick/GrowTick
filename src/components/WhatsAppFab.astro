---
import Icon from './Icon.astro';
import { whatsappChatHref } from '../config/site';
interface Props { topic?: string }
const { topic } = Astro.props;
---
<a class="fab" id="wa-fab" href={whatsappChatHref(topic)} target="_blank" rel="noopener" data-track="whatsapp" data-label="fab" aria-label="Chat with Growtick on WhatsApp">
  <Icon name="whatsapp" class="fab__icon" />
</a>

<style>
  .fab {
    position: fixed; right: 1rem; bottom: 1rem; z-index: 50;
    width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center;
    background: #128c4a; color: #fff; box-shadow: 0 6px 20px rgb(0 0 0 / 0.25);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .fab:hover { transform: scale(1.06); }
  .fab :global(.fab__icon) { width: 30px; height: 30px; }
  :global(.nav-open) .fab { display: none; }
  :global(.fab-hidden) .fab { opacity: 0; transform: translateY(120%); pointer-events: none; }
</style>
