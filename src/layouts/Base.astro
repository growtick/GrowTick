---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import { ICON_SPRITE } from '../components/icons.generated';
import { site } from '../config/site';
import { cityfy, cleanPath } from '../lib/content';
import { PUBLIC_CF_ANALYTICS_TOKEN } from 'astro:env/client';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  jsonLd?: object[];
  noindex?: boolean;
  waTopic?: string;
}
const { title, description, ogImage = '/og-default.png', jsonLd = [], noindex = false, waTopic } = Astro.props;
const fullTitle = cityfy(title.includes(site.name) ? title : `${title} | ${site.name}`);
const desc = cityfy(description);
const canonical = new URL(cleanPath(Astro.url.pathname), Astro.site).href;
const og = new URL(ogImage, Astro.site).href;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: Astro.site?.href,
  logo: new URL('/icon-512.png', Astro.site).href,
  slogan: site.tagline,
  telephone: `+${site.phoneE164}`,
  sameAs: [site.instagramUrl, site.googleBusinessUrl].filter(Boolean),
};
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#042e1a" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/space-grotesk-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Theme before first paint: saved choice, else device setting. -->
    <script is:inline>
      (function () {
        var t;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'dark' && t !== 'light') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
    {[organization, ...jsonLd].map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <Fragment set:html={ICON_SPRITE} />
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppFab topic={waTopic} />
    <div id="cf-analytics" data-token={PUBLIC_CF_ANALYTICS_TOKEN ?? ''} hidden></div>
    <script>
      import { initSite } from '../scripts/site';
      initSite();
    </script>
  </body>
</html>
