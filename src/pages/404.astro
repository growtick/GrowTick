---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { telHref, whatsappChatHref } from '../config/site';
---
<Base title="Page not found" description="This page doesn't exist. Explore Growtick services or contact us." noindex>
  <div class="wrap page-head pb-xl">
    <p class="overline">Error 404</p>
    <h1>We couldn’t find that page</h1>
    <p class="lead">The link may be old or mistyped. Here’s where you can go instead:</p>
    <div class="btn-row">
      <a class="btn" href="/services"><Icon name="arrow" /> Browse services</a>
      <a class="btn btn--alt" href="/contact#enquiry">Contact us</a>
      <a class="btn btn--ghost" href={telHref}><Icon name="phone" /> Call</a>
      <a class="btn btn--ghost" href={whatsappChatHref()} target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp</a>
    </div>
  </div>
</Base>
