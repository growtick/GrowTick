# Copy to .env for local dev (never commit .env). In production set these as
# Cloudflare Worker variables/secrets and GitHub Actions secrets (see README).

SITE_URL=https://www.growtick.in            # TODO(PRD-OQ#4) final domain
SHOW_SAMPLES=                               # 1 on preview builds to show sample testimonials

# Supabase (Project settings → API)
PUBLIC_SUPABASE_URL=https://pbnynqqossnzfuyucqvj.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBibnlucXFvc3NuemZ1eXVjcXZqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTM5MTUyNDgsImV4cCI6MjEwOTQ5MTI0OH0.Zvl857HHR26ghqfx5w-rGN9ePAQmiIjLwbHmlzM1FlM
SUPABASE_URL=https://pbnynqqossnzfuyucqvj.supabase.co                               # same as PUBLIC_SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBibnlucXFvc3NuemZ1eXVjcXZqIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MzkxNTI0OCwiZXhwIjoyMTA5NDkxMjQ4fQ.6Vu6rtq7gYqKqHCCoWiXI1RU39zM4T3BYCZ7S8q9HRA                  # SECRET — server and build only
# SUPABASE_KEY=sb_publishable_-3swMJJT2Kb5ELoLc3oHaA_6n5WNk9P             # SECRET — server and build only

# Cloudflare Turnstile (invisible CAPTCHA)
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAF1oJauByyrcQjqK
TURNSTILE_SECRET_KEY=                       # SECRET — required in production (leads are refused without it)
TURNSTILE_HOSTNAMES=localhost,127.0.0.1     # production: www.growtick.in,growtick.in (no localhost)

# Cloudflare Web Analytics token (Analytics & Logs → Web Analytics → Add site)
PUBLIC_CF_ANALYTICS_TOKEN=

# Resend (lead alerts + server error emails)
RESEND_API_KEY=
ALERT_EMAIL_TO=                             # TODO(PRD-OQ#5) comma-separated
ALERT_EMAIL_FROM="Growtick Website <alerts@growtick.in>"

# Admin panel lives at https://<domain>/<ADMIN_PATH>. Make it long and random.
ADMIN_PATH=
# Random string for hashing visitor IPs in the rate limiter.
IP_HASH_SALT=
# "Publish changes" in the admin starts the GitHub Actions deploy workflow:
GITHUB_REPO=growtick/growtick-site            # owner/repo
GITHUB_DISPATCH_TOKEN=                      # fine-grained token, this repo only, Contents: read & write
# …or, instead, any URL that starts a build when POSTed to:
DEPLOY_HOOK_URL=
